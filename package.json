{
	"name": "healthcare-clinic",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check:lint": "biome check --fix",
		"check:types": "tsc --noEmit",
		"clean": "bunx rimraf --glob \"**/{node_modules,.output,.local,.tanstack,bun.lockb}\"",
		"db:studio": "bun infra:dev-run -- bun aspen db-studio --config=./src/aspen/server.ts",
		"dev": "bun infra:dev-run -- vite dev --port 4020",
		"dev:prepare": "bun infra:dev-run -- bun scripts/local-only/prepare.ts",
		"dev:seed": "bun infra:dev-run -- bun scripts/local-only/seed.ts",
		"gen:routes": "tsr generate",
		"infra:dev-run": "bun infra/utils/run-command.ts --verbose --stack dev --",
		"infra:down": "pulumi destroy --stack",
		"infra:preview": "pulumi preview --stack",
		"infra:refresh": "pulumi refresh --stack",
		"infra:up": "pulumi up --stack",
		"prepare": "husky",
		"preview": "bun infra:dev-run -- vite preview",
		"test": "bun infra:dev-run -- vitest run",
		"update-deps": "bun update --latest && bun install"
	},
	"overrides": {
		"@opentelemetry/api": "1.9.0",
		"@opentelemetry/core": "1.28.0",
		"@opentelemetry/sdk-trace-base": "1.28.0"
	},
	"dependencies": {
		"@aspen-os/healthcare": "link:@aspen-os/healthcare",
		"@aspen-os/management": "link:@aspen-os/management",
		"@aspen-os/masters": "link:@aspen-os/masters",
		"@aspen-os/platform": "link:@aspen-os/platform",
		"@aws-sdk/client-s3": "^3.1127.0",
		"@aws-sdk/s3-request-presigner": "^3.1127.0",
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/arimo": "^5.3.0",
		"@fontsource-variable/google-sans": "^5.3.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/scoutie-sans": "^5.3.1",
		"@hookform/resolvers": "^5.9.1",
		"@orpc/client": "^1.15.0",
		"@orpc/server": "^1.15.0",
		"@paralleldrive/cuid2": "^3.3.0",
		"@posthog/react": "^1.10.6",
		"@t3-oss/env-core": "^0.13.11",
		"@tabler/icons-react": "^3.46.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "^1.170.33",
		"@tanstack/react-router-ssr-query": "^1.167.2",
		"@tanstack/react-start": "^1.168.50",
		"@tanstack/router-plugin": "^1.168.37",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.2.6",
		"lucide-react": "^1.44.0",
		"motion": "^13.2.0",
		"nitro": "^3.0.260903-beta",
		"posthog-js": "^1.429.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.87.0",
		"shadcn": "^4.21.0",
		"sonner": "^2.0.8",
