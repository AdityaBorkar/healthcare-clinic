    "@tanstack/router-cli": "^1.167.27",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "commander": "^15.0.0",
    "deepmerge": "^4.3.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*": "biome format --fix --no-errors-on-unmatched"
  },
  "name": "healthcare-clinic",
  "overrides": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "1.28.0",
    "@opentelemetry/sdk-trace-base": "1.28.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "lightningcss"]
  },
  "private": true,
  "scripts": {
    "build": "vite build",
    "check:lint": "biome check --fix .",
    "check:types": "tsc --noEmit",
    "clean": "bunx rimraf --glob \"**/{node_modules,.output,.local,.tanstack,bun.lockb}\"",
    "db:studio": "bun infra:dev-run -- bun aspen db-studio --config=./src/aspen/server.ts",
    "dev": "bun infra:dev-run -- vite dev --port 4020",
    "gen:routes": "tsr generate",
    "infra:dev-run": "bun ./infra/run-command.ts --verbose --stack dev --",
    "infra:down": "pulumi destroy --stack",
    "infra:preview": "pulumi preview --stack",
    "infra:refresh": "pulumi refresh --stack",
    "infra:up": "pulumi up --stack",
    "prepare": "husky",
    "preview": "bun infra:dev-run -- vite preview",
    "test": "bun infra:dev-run -- vitest run",
    "update:deps": "bun update --latest && bun install"
  },
  "type": "module"
}
